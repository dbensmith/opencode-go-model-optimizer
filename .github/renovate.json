{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 6am"
  ],
  "automerge": true,
  "automergeType": "pr",
  "description": "Repo has GitHub auto-merge disabled, so platformAutomerge is off; Renovate automerges itself once CI passes.",
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "ignoreTests": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am"
    ],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Docsify core, themes, and plugins loaded via jsDelivr CDN in docs/index.html",
      "managerFilePatterns": [
        "/^docs/index\\.html$/"
      ],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/npm/(?<depName>@?[^@/]+(?:/[^@/]+)?)@(?<currentValue>[^/\"'\\s]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track uv version pinned in setup-uv action inputs",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-env/action\\.yml$/"
      ],
      "matchStrings": [
        "uses:\\s*astral-sh/setup-uv@[^\\s]+\\s+with:\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track uv version pinned in the Paseo worktree setup hook installer URL",
      "managerFilePatterns": [
        "/^paseo\\.json$/"
      ],
      "matchStrings": [
        "https://astral\\.sh/uv/(?<currentValue>[^/\"'\\s]+)/install\\.sh"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Daily automerge for non-major PyPI, GitHub Actions, and Docsify/npm dependencies",
      "matchDatasources": [
        "pypi",
        "github-actions",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Group Docsify core, plugins, and syntax highlighting CDN assets",
      "matchDatasources": [
        "npm"
      ],
      "groupName": "docsify plugins"
    },
    {
      "description": "Automerge vulnerability fixes immediately once CI passes",
      "matchCategories": [
        "security"
      ],
      "schedule": [
        "at any time"
      ],
      "automerge": true
    },
    {
      "description": "Group the uv toolchain so the CI uv pin and uv_build requirement move together",
      "matchPackageNames": [
        "uv",
        "uv_build",
        "uv-build",
        "astral-sh/uv",
        "astral-sh/setup-uv"
      ],
      "groupName": "uv toolchain"
    },
    {
      "description": "Bumping .python-version changes the CI/dev interpreter; review requires-python, classifiers and README together",
      "matchDepNames": [
        "python"
      ],
      "matchManagers": [
        "pyenv"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "python"
      ]
    },
    {
      "description": "requires-python is a support floor, not something to auto-bump",
      "matchManagers": [
        "pep621"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Require manual review for major breaking upgrades",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
